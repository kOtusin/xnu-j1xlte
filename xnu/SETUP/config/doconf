#!/bin/sh
# POSIX-sh reimplementation of XNU SETUP/config/doconf (tcsh).
# Supports the subset used by */conf/Makefile: -c -cpu CPU -soc SOC -d OBJDIR [-verbose] SYS...
prog=`basename "$0"`
DOCONFIG=; MACHINE=; SOC_CONFIG=; OBJDIR=; VERBOSE=
while [ $# -ge 1 ]; do
  case "$1" in
    -c|-config) DOCONFIG=1; shift;;
    -cpu) [ $# -lt 2 ] && { echo "$prog: missing argument to $1"; exit 1; }; MACHINE="$2"; shift 2;;
    -soc) [ $# -lt 2 ] && { echo "$prog: missing argument to $1"; exit 1; }; SOC_CONFIG="$2"; shift 2;;
    -d) [ $# -lt 2 ] && { echo "$prog: missing argument to $1"; exit 1; }; OBJDIR="$2"; shift 2;;
    -verbose) VERBOSE=1; shift;;
    -*) echo "$prog: $1: unknown switch" >&2; exit 1;;
    *) break;;
  esac
done
[ $# -eq 0 ] && set -- GENERIC
CONFIG_DIR=$OBJROOT/SETUP/config
[ -z "$MACHINE" ] && { echo "$prog: specify machine type with -cpu" >&2; exit 1; }
cpu=`printf '%s' "$MACHINE" | tr A-Z a-z`
ID=`printf '%s' "$MACHINE" | tr a-z A-Z`
MASTER_DIR=../conf
MASTER=$MASTER_DIR/MASTER
MASTER_CPU=$MASTER.$cpu
MASTER_CPU_PER_SOC=$MASTER.$cpu.$SOC_CONFIG
[ -f "$MASTER_CPU_PER_SOC" ] && MASTER_CPU=$MASTER_CPU_PER_SOC
MASTER_LOCAL=$MASTER.local
MASTER_CPU_LOCAL=$MASTER_CPU.local
MASTER_CPU_PER_SOC_LOCAL=$MASTER_CPU_PER_SOC.local
[ -f "$MASTER_LOCAL" ] || MASTER_LOCAL=
[ -f "$MASTER_CPU_LOCAL" ] || MASTER_CPU_LOCAL=
[ -f "$MASTER_CPU_PER_SOC_LOCAL" ] && MASTER_CPU_LOCAL=$MASTER_CPU_PER_SOC_LOCAL
[ -d "$OBJDIR" ] || mkdir -p "$OBJDIR"
_one_sys() {
SYS=$1
SYSID=${SYS}_${ID}
SYSCONF=$OBJDIR/config.$SYSID
BLDDIR=$OBJDIR
[ -n "$VERBOSE" ] && echo "[ generating $SYSID from $MASTER_DIR/MASTER{,.$cpu}{,.local} ]"
set -- "$MASTER"
[ -n "$MASTER_LOCAL" ] && set -- "$@" "$MASTER_LOCAL"
set -- "$@" "$MASTER_CPU"
[ -n "$MASTER_CPU_LOCAL" ] && set -- "$@" "$MASTER_CPU_LOCAL"
set -- "$@" - "$MASTER"
[ -n "$MASTER_LOCAL" ] && set -- "$@" "$MASTER_LOCAL"
set -- "$@" "$MASTER_CPU"
[ -n "$MASTER_CPU_LOCAL" ] && set -- "$@" "$MASTER_CPU_LOCAL"
printf '+%s\n' "$SYS" | cat "$@" | \
    sed -n \
	-e "/^+/{" \
	   -e "s;[-+];#&;gp" \
	      -e 't loop' \
	   -e ': loop' \
           -e 'n' \
	   -e '/^#/b loop' \
	   -e '/^$/b loop' \
	   -e 's;^\([^#]*\).*#[ 	]*<\(.*\)>[ 	]*$;\2#\1;' \
	      -e 't not' \
	   -e 's;\([^#]*\).*;#\1;' \
	      -e 't not' \
	   -e ': not' \
	   -e 's;[ 	]*$;;' \
	   -e 's;^\!\(.*\);\1#\!;' \
	   -e 'p' \
	      -e 't loop' \
           -e 'b loop' \
	-e '}' \
	-e "/^[^#]/d" \
	-e 's;	; ;g' \
	-e "s;^# *\([^ ]*\)[ ]*=[ ]*\[\(.*\)\].*;\1#\2;p" \
    | \
    awk '-F#' '\
part == 0 && $1 != "" {\
	m[$1]=m[$1] " " $2;\
	next;\
}\
part == 0 && $1 == "" {\
	for (i=NF;i>1;i--){\
		s=substr($i,2);\
		c[++na]=substr($i,1,1);\
		a[na]=s;\
	}\
	while (na > 0){\
		s=a[na];\
		d=c[na--];\
		if (m[s] == "") {\
			f[s]=d;\
		} else {\
			nx=split(m[s],x," ");\
			for (j=nx;j>0;j--) {\
				z=x[j];\
				a[++na]=z;\
				c[na]=d;\
			}\
		}\
	}\
	part=1;\
	next;\
}\
part != 0 {\
	if ($1 != "") {\
		n=split($1,x,",");\
		ok=0;\
		for (i=1;i<=n;i++) {\
			if (f[x[i]] == "+") {\
				ok=1;\
			}\
		}\
		if (NF > 2 && ok == 0 || NF <= 2 && ok != 0) {\
			print $2; \
		}\
	} else { \
		print $2; \
	}\
}\
' >"$SYSCONF.new"

if [ ! -s "$SYSCONF.new" ]; then echo "$prog: ${SYSID}: no such configuration in $MASTER_DIR/MASTER{,.$cpu}"; rm -f "$SYSCONF.new"; return 1; fi
[ -d "$BLDDIR" ] || mkdir -p "$BLDDIR"
printf 'builddir\t"."\n' >> "$SYSCONF.new"
printf 'objectdir\t"%s"\n' "$OBJDIR" >> "$SYSCONF.new"
printf 'sourcedir\t"%s"\n' "$SRCROOT" >> "$SYSCONF.new"
if [ -f "$SYSCONF" ]; then diff "$SYSCONF" "$SYSCONF.new"; rm -f "$SYSCONF.old"; mv "$SYSCONF" "$SYSCONF.old"; fi
rm -f "$SYSCONF"; mv "$SYSCONF.new" "$SYSCONF"
if [ -n "$DOCONFIG" ]; then
[ -n "$VERBOSE" ] && echo "[ configuring $SYSID ]"
"$CONFIG_DIR/config" -c "$MASTER_DIR" "$SYSCONF"
fi
}
for SYSARG in "$@"; do _one_sys "$SYSARG"; done
